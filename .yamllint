extends: default

ignore: |
  .git/

rules:
  line-length:
    max: 140
    # Sealed values are long base64 strings; workflows hold pinned URLs and
    # shell one-liners.
    ignore: |
      **/sealed-secrets.yaml
      .github/workflows/
  document-start: disable
  truthy:
    # GitHub Actions uses the key "on".
    allowed-values: ['true', 'false', 'on']
  indentation:
    indent-sequences: consistent
  comments:
    min-spaces-from-content: 1
